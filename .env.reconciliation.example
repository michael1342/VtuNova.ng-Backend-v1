# Add these optional settings to the existing worker environment.
# Existing MONGODB_URI, REDIS_HOST, REDIS_PORT, REDIS_PASSWORD and REDIS_URL are required.
# Use the same provider and SMTP configuration as the API. Never copy credentials into source.
VTU_RECONCILE_SWEEP_MS=60000
VTU_RECONCILE_CHECK_MS=300000
VTU_RECONCILE_REVIEW_AFTER_MS=86400000
VTU_RECONCILE_REVIEW_MS=3600000
VTU_RECONCILE_LEASE_MS=180000
VTU_RECONCILE_BATCH_SIZE=50
VTU_RECONCILE_CONCURRENCY=3
