# Merge email settings into your existing .env; do not replace other app secrets.
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/vtunova
# Existing BullMQ and OTP/cache clients must use the same Redis.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379

EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Use a mailbox on your VERIFIED Resend domain (bare address or Name <address>).
RESEND_FROM=VtuNova <hello@your-verified-domain.example>
# Required: base64 of 32 random bytes; identical on all API/worker processes.
EMAIL_PAYLOAD_ENCRYPTION_KEY= k4apgdyfeZGeYbJpb0pZyxnPt79nfr1Vce1kV2tYhgA=

# Three TOTAL attempts, including the first; BullMQ alone performs retries.
EMAIL_MAX_ATTEMPTS=3
EMAIL_BACKOFF_MS=10000
EMAIL_TIMEOUT_MS=30000
EMAIL_CONCURRENCY=5
EMAIL_RECOVERY_INTERVAL_MS=60000
EMAIL_RECOVERY_BATCH_SIZE=50
EMAIL_LOG_RETENTION_DAYS=180
EMAIL_PAYLOAD_RETENTION_HOURS=24
EMAIL_FAILED_JOB_RETENTION_DAYS=7
EMAIL_FAILED_JOB_RETENTION_COUNT=1000

# Used only when EMAIL_PROVIDER=smtp; no automatic provider failover.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Existing BRAND / credential settings.
APP_NAME=VtuNova
APP_URL=https://your-app.example
SUPPORT_EMAIL=support@your-domain.example
OTP_EXPIRES_IN=600
OTP_SECRET=
